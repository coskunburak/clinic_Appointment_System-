# ==============================================================================
# Local Development PostgreSQL Configuration Template
# ==============================================================================
# Copy this file to .env for local Docker Compose and Spring Boot development:
#   cp .env.example .env
#
# SECURITY WARNING:
# Never commit the actual .env file or production credentials to version control!
# .env is already registered in .gitignore.
# ==============================================================================

POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_dev_secret_change_me
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
